---
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  slideNumber: number;
  totalSlides?: number;
}

const { title, slideNumber, totalSlides = 16 } = Astro.props;

const navLinks = [
  { label: 'Home',         href: '/slide/1',  match: [1] },
  { label: 'Architecture', href: '/slide/2',  match: [2] },
  { label: 'Features',     href: '/slide/3',  match: [3] },
  { label: 'AI Pipeline',  href: '/slide/4',  match: [4] },
  { label: 'Tech Stack',   href: '/slide/5',  match: [5] },
  { label: 'Security',     href: '/slide/6',  match: [6] },
  { label: 'Frontend',     href: '/slide/7',  match: [7] },
  { label: 'Infra',        href: '/slide/8',  match: [8] },
  { label: 'Code',         href: '/slide/9',  match: [9,10,11,12,13,14,15] },
  { label: 'Closing',      href: '/slide/16', match: [16] },
];

const isActive = (match: number[]) => match.includes(slideNumber);
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Onmeet - B2B 화상회의 플랫폼 기술 발표" />
    <title>{title} — Onmeet</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="/src/styles/global.css" />
    <ClientRouter />
  </head>
  <body class="bg-[#170230] text-[#f0dfff] font-[Inter,sans-serif] overflow-hidden h-screen">

    <!-- Background nebula orbs -->
    <div aria-hidden="true" class="fixed inset-0 z-0 overflow-hidden pointer-events-none">
      <div class="nebula-orb w-[600px] h-[600px] bg-[#9333EA] top-[-200px] left-[-150px]"></div>
      <div class="nebula-orb w-[500px] h-[500px] bg-[#9e41f5] bottom-[-150px] right-[-100px]"></div>
      <div class="nebula-orb w-[400px] h-[400px] bg-[#331557] top-[40%] left-[50%] translate-x-[-50%]"></div>
    </div>

    <!-- Top nav -->
    <nav class="fixed top-0 left-0 right-0 z-50 h-14 flex items-center justify-between px-8 glass-card-bright rounded-none border-x-0 border-t-0">
      <a href="/slide/1" class="flex items-center gap-2 no-underline">
        <span class="font-['Manrope',sans-serif] font-extrabold text-xl text-glow-sm" style="color:#cc97ff;">Onmeet</span>
        <span class="text-sm text-[#9e41f5] font-medium hidden sm:inline">Presentation</span>
      </a>
      <div class="flex items-center gap-1.5 overflow-x-auto">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class={`text-sm px-3 py-1.5 rounded transition-colors whitespace-nowrap no-underline font-medium ${isActive(link.match) ? 'nav-active text-[#cc97ff]' : 'text-[#f0dfff]/70 hover:text-[#cc97ff]'}`}
          >
            {link.label}
          </a>
        ))}
      </div>
    </nav>

    <!-- Slide content -->
    <main class="relative z-10 h-screen pt-14 pb-12 flex items-center justify-center overflow-hidden">
      <slot />
    </main>

    <!-- Bottom bar -->
    <footer class="fixed bottom-0 left-0 right-0 z-50 h-12 flex items-center justify-between px-8 glass-card-bright rounded-none border-x-0 border-b-0">
      <span class="text-sm text-[#cc97ff]/80 font-medium">
        {slideNumber} <span class="text-[#533e6d]">/</span> {totalSlides}
      </span>
      <div class="flex items-center gap-4">
        {slideNumber > 1 && (
          <a href={`/slide/${slideNumber - 1}`} class="text-sm text-[#f0dfff]/50 hover:text-[#cc97ff] transition-colors no-underline">← Prev</a>
        )}
        {slideNumber < totalSlides && (
          <a href={`/slide/${slideNumber + 1}`} class="text-sm text-[#f0dfff]/50 hover:text-[#cc97ff] transition-colors no-underline">Next →</a>
        )}
        <span class="text-[#533e6d] hidden sm:inline">|</span>
        <button id="btn-fullscreen" class="text-sm text-[#f0dfff]/50 hover:text-[#cc97ff] transition-colors cursor-pointer bg-transparent border-none" title="전체화면 (F)">⛶ 전체화면</button>
        <button id="btn-pdf" class="text-sm text-[#f0dfff]/50 hover:text-[#cc97ff] transition-colors cursor-pointer bg-transparent border-none" title="PDF 다운로드">📄 PDF</button>
        <span class="text-sm text-[#f0dfff]/30 hidden sm:inline ml-1">← → F</span>
      </div>
    </footer>

  </body>
</html>

<script>
  import { navigate } from 'astro:transitions/client';

  function getSlideNumber() {
    const match = window.location.pathname.match(/\/slide\/(\d+)/);
    return match ? parseInt(match[1]) : 1;
  }

  const TOTAL = 16;

  function goToSlide(n: number) {
    if (n >= 1 && n <= TOTAL) {
      navigate(`/slide/${n}`);
    }
  }

  function toggleFullscreen() {
    if (!document.fullscreenElement) {
      document.documentElement.requestFullscreen().catch(() => {});
    } else {
      document.exitFullscreen();
    }
  }

  function setupListeners() {
    const current = getSlideNumber();

    document.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
        e.preventDefault();
        goToSlide(getSlideNumber() + 1);
      } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
        e.preventDefault();
        goToSlide(getSlideNumber() - 1);
      } else if (e.key === 'f' || e.key === 'F') {
        toggleFullscreen();
      }
    });

    document.getElementById('btn-fullscreen')?.addEventListener('click', toggleFullscreen);

    document.getElementById('btn-pdf')?.addEventListener('click', () => {
      const btn = document.getElementById('btn-pdf');
      if (btn) btn.textContent = '📄 생성 중...';

      const printWin = window.open('', '_blank');
      if (!printWin) { if (btn) btn.textContent = '📄 PDF'; return; }

      printWin.document.write(`<!DOCTYPE html><html><head>
        <meta charset="UTF-8"><title>Onmeet Presentation PDF</title>
        <style>
          @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;700;800&family=Inter:wght@400;500;600&display=swap');
          *{margin:0;padding:0;box-sizing:border-box}
          body{background:#170230;color:#f0dfff;font-family:Inter,sans-serif}
          .page{width:100vw;height:100vh;page-break-after:always;overflow:hidden}
          .page:last-child{page-break-after:avoid}
          iframe{width:100%;height:100%;border:none}
          @media print{nav,footer{display:none!important}}
        </style></head><body>`);

      for (let i = 1; i <= TOTAL; i++) {
        printWin.document.write(`<div class="page"><iframe src="/slide/${i}"></iframe></div>`);
      }
      printWin.document.write('</body></html>');
      printWin.document.close();

      setTimeout(() => {
        printWin.print();
        if (btn) btn.textContent = '📄 PDF';
      }, 3000);
    });
  }

  // Run on initial load
  setupListeners();

  // Re-run after Astro client-side navigation
  document.addEventListener('astro:after-swap', setupListeners);
</script>

<style is:global>
  @import '../styles/global.css';
</style>
