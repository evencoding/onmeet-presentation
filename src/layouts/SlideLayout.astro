---
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  slideNumber: number;
  totalSlides?: number;
}

const { title, slideNumber, totalSlides = 21 } = Astro.props;

const navLinks = [
  { label: 'Home',         href: '/slide/1',  match: [1] },
  { label: 'Team',         href: '/slide/2',  match: [2] },
  { label: 'Architecture', href: '/slide/3',  match: [3] },
  { label: 'Features',     href: '/slide/4',  match: [4] },
  { label: 'AI Pipeline',  href: '/slide/5',  match: [5] },
  { label: 'Tech Stack',   href: '/slide/6',  match: [6] },
  { label: 'Security',     href: '/slide/7',  match: [7] },
  { label: 'Frontend',     href: '/slide/8',  match: [8] },
  { label: 'Infra',        href: '/slide/9',  match: [9] },
  { label: 'Code',         href: '/slide/10', match: [10,11,12,13,14,15,16] },
  { label: '회고',          href: '/slide/17', match: [17,18,19,20] },
  { label: 'Closing',      href: '/slide/21', match: [21] },
];

const isActive = (match: number[]) => match.includes(slideNumber);

const isCodeSlide = slideNumber >= 10 && slideNumber <= 16;
const isRetroSlide = slideNumber >= 17 && slideNumber <= 20;
const retroSubNav = [
  { label: '최승은',  href: '/slide/17', num: 17 },
  { label: '박영진',  href: '/slide/18', num: 18 },
  { label: '조예성',  href: '/slide/19', num: 19 },
  { label: '양진영',  href: '/slide/20', num: 20 },
];
const codeSubNav = [
  { label: 'auth',         href: '/slide/10', num: 10 },
  { label: 'gateway',      href: '/slide/11', num: 11 },
  { label: 'video',        href: '/slide/12', num: 12 },
  { label: 'ai',           href: '/slide/13', num: 13 },
  { label: 'notification', href: '/slide/14', num: 14 },
  { label: 'file',         href: '/slide/15', num: 15 },
  { label: 'email',        href: '/slide/16', num: 16 },
];
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Onmeet - B2B 화상회의 플랫폼 기술 발표" />
    <title>{title} — Onmeet</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="/src/styles/global.css" />
    <ClientRouter />
  </head>
  <body class="bg-[#170230] text-[#f0dfff] font-[Inter,sans-serif] overflow-hidden h-screen">

    <!-- Background nebula orbs -->
    <div aria-hidden="true" class="fixed inset-0 z-0 overflow-hidden pointer-events-none">
      <div class="nebula-orb w-[600px] h-[600px] bg-[#9333EA] top-[-200px] left-[-150px]"></div>
      <div class="nebula-orb w-[500px] h-[500px] bg-[#9e41f5] bottom-[-150px] right-[-100px]"></div>
      <div class="nebula-orb w-[400px] h-[400px] bg-[#331557] top-[40%] left-[50%] translate-x-[-50%]"></div>
    </div>

    <!-- Top nav -->
    <nav class="fixed top-0 left-0 right-0 z-50 h-14 flex items-center justify-between px-8 glass-card-bright rounded-none border-x-0 border-t-0 mobile-nav">
      <a href="/slide/1" class="flex items-center gap-2 no-underline">
        <span class="font-['Manrope',sans-serif] font-extrabold text-xl text-glow-sm" style="color:#cc97ff;">Onmeet</span>
        <span class="text-sm text-[#9e41f5] font-medium hidden sm:inline">Presentation</span>
      </a>

      <!-- Desktop nav -->
      <div class="flex items-center gap-1.5 overflow-x-auto nav-links-desktop">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class={`text-sm px-3 py-1.5 rounded transition-colors whitespace-nowrap no-underline font-medium ${isActive(link.match) ? 'nav-active text-[#cc97ff]' : 'text-[#f0dfff]/70 hover:text-[#cc97ff]'}`}
          >
            {link.label}
          </a>
        ))}
      </div>

      <!-- Mobile hamburger button -->
      <button
        id="btn-hamburger"
        class="mobile-hamburger hidden items-center justify-center w-10 h-10 bg-transparent border-none cursor-pointer"
        aria-label="메뉴 열기"
      >
        <div class="hamburger-icon flex flex-col gap-1.5">
          <span class="block w-6 h-0.5 bg-[#cc97ff] rounded transition-all"></span>
          <span class="block w-6 h-0.5 bg-[#cc97ff] rounded transition-all"></span>
          <span class="block w-6 h-0.5 bg-[#cc97ff] rounded transition-all"></span>
        </div>
      </button>
    </nav>

    <!-- Mobile menu overlay -->
    <div id="mobile-menu" class="mobile-menu fixed inset-0 z-[60] hidden" style="background:rgba(23,2,48,0.95);backdrop-filter:blur(20px);">
      <div class="flex flex-col h-full pt-14">
        <!-- Close button -->
        <div class="flex justify-end px-6 py-3">
          <button id="btn-menu-close" class="text-2xl text-[#cc97ff] bg-transparent border-none cursor-pointer">✕</button>
        </div>

        <!-- Menu items -->
        <div class="flex-1 overflow-y-auto px-6 pb-8">
          <div class="flex flex-col gap-1">
            {navLinks.map((link) => {
              const isCode = link.label === 'Code';
              const isRetro = link.label === '회고';
              return (
                <>
                  <a
                    href={link.href}
                    class={`mobile-menu-link text-lg px-4 py-3 rounded-lg transition-colors no-underline font-medium ${isActive(link.match) ? 'text-[#cc97ff]' : 'text-[#f0dfff]/70'}`}
                    style={isActive(link.match) ? 'background:rgba(204,151,255,0.1);' : ''}
                  >
                    {link.label}
                    {isCode && isCodeSlide && (
                      <span class="text-xs text-[#f0dfff]/40 ml-2">({codeSubNav.find(s => s.num === slideNumber)?.label})</span>
                    )}
                    {isRetro && isRetroSlide && (
                      <span class="text-xs text-[#f0dfff]/40 ml-2">({retroSubNav.find(s => s.num === slideNumber)?.label})</span>
                    )}
                  </a>
                  {isCode && (
                    <div class="flex flex-col gap-0.5 pl-6 mb-1">
                      {codeSubNav.map((sub) => (
                        <a
                          href={sub.href}
                          class={`mobile-menu-link text-sm px-3 py-2 rounded-md transition-colors no-underline ${
                            slideNumber === sub.num
                              ? 'text-[#170230] font-bold'
                              : 'text-[#f0dfff]/50'
                          }`}
                          style={slideNumber === sub.num ? 'background:#cc97ff;' : ''}
                        >
                          {sub.label}
                        </a>
                      ))}
                    </div>
                  )}
                  {isRetro && (
                    <div class="flex flex-col gap-0.5 pl-6 mb-1">
                      {retroSubNav.map((sub) => (
                        <a
                          href={sub.href}
                          class={`mobile-menu-link text-sm px-3 py-2 rounded-md transition-colors no-underline ${
                            slideNumber === sub.num
                              ? 'text-[#170230] font-bold'
                              : 'text-[#f0dfff]/50'
                          }`}
                          style={slideNumber === sub.num ? 'background:#cc97ff;' : ''}
                        >
                          {sub.label}
                        </a>
                      ))}
                    </div>
                  )}
                </>
              );
            })}
          </div>

          <!-- Slide counter -->
          <div class="mt-6 text-center">
            <span class="text-sm text-[#cc97ff]/60">{slideNumber} / {totalSlides}</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Code sub-nav (desktop only) -->
    {isCodeSlide && (
      <div class="fixed top-14 left-0 right-0 z-40 h-9 flex items-center justify-center gap-1 px-8 code-subnav" style="background:rgba(23,2,48,0.85);backdrop-filter:blur(12px);border-bottom:1px solid rgba(83,62,109,0.2);">
        {codeSubNav.map((item) => (
          <a
            href={item.href}
            class={`text-xs px-2.5 py-1 rounded-full transition-all no-underline font-medium ${
              slideNumber === item.num
                ? 'text-[#170230] font-bold'
                : 'text-[#f0dfff]/50 hover:text-[#cc97ff]'
            }`}
            style={slideNumber === item.num ? 'background:#cc97ff;' : ''}
          >
            {item.label}
          </a>
        ))}
      </div>
    )}

    <!-- Team sub-nav (desktop only) -->
    {isRetroSlide && (
      <div class="fixed top-14 left-0 right-0 z-40 h-9 flex items-center justify-center gap-1 px-8 code-subnav" style="background:rgba(23,2,48,0.85);backdrop-filter:blur(12px);border-bottom:1px solid rgba(83,62,109,0.2);">
        {retroSubNav.map((item) => (
          <a
            href={item.href}
            class={`text-xs px-2.5 py-1 rounded-full transition-all no-underline font-medium ${
              slideNumber === item.num
                ? 'text-[#170230] font-bold'
                : 'text-[#f0dfff]/50 hover:text-[#cc97ff]'
            }`}
            style={slideNumber === item.num ? 'background:#cc97ff;' : ''}
          >
            {item.label}
          </a>
        ))}
      </div>
    )}

    <!-- Slide content -->
    <main class={`relative z-10 h-screen ${isCodeSlide || isRetroSlide ? 'pt-[5.75rem]' : 'pt-14'} pb-12 flex items-center justify-center overflow-hidden`}>
      <slot />
    </main>

    <!-- Bottom bar -->
    <footer class="fixed bottom-0 left-0 right-0 z-50 h-12 flex items-center justify-between px-8 glass-card-bright rounded-none border-x-0 border-b-0">
      <span class="text-sm text-[#cc97ff]/80 font-medium">
        {slideNumber} <span class="text-[#533e6d]">/</span> {totalSlides}
      </span>
      <div class="flex items-center gap-4">
        {slideNumber > 1 && (
          <a href={`/slide/${slideNumber - 1}`} class="text-sm text-[#f0dfff]/50 hover:text-[#cc97ff] transition-colors no-underline">← Prev</a>
        )}
        {slideNumber < totalSlides && (
          <a href={`/slide/${slideNumber + 1}`} class="text-sm text-[#f0dfff]/50 hover:text-[#cc97ff] transition-colors no-underline">Next →</a>
        )}
        <span class="text-[#533e6d] hidden sm:inline mobile-hide">|</span>
        <button id="btn-fullscreen" class="text-sm text-[#f0dfff]/50 hover:text-[#cc97ff] transition-colors cursor-pointer bg-transparent border-none mobile-hide" title="전체화면 (F)">⛶ 전체화면</button>
        <button id="btn-pdf" class="text-sm text-[#f0dfff]/50 hover:text-[#cc97ff] transition-colors cursor-pointer bg-transparent border-none mobile-hide" title="PDF 다운로드">📄 PDF</button>
        <span class="text-sm text-[#f0dfff]/30 hidden sm:inline ml-1 mobile-hide">← → F</span>
      </div>
    </footer>

  </body>
</html>

<script>
  import { navigate } from 'astro:transitions/client';

  function getSlideNumber() {
    const match = window.location.pathname.match(/\/slide\/(\d+)/);
    return match ? parseInt(match[1]) : 1;
  }

  const TOTAL = 21;

  function goToSlide(n: number) {
    if (n >= 1 && n <= TOTAL) {
      navigate(`/slide/${n}`);
    }
  }

  function toggleFullscreen() {
    if (!document.fullscreenElement) {
      document.documentElement.requestFullscreen().catch(() => {});
    } else {
      document.exitFullscreen();
    }
  }

  function setupMobileMenu() {
    const btn = document.getElementById('btn-hamburger');
    const menu = document.getElementById('mobile-menu');
    const closeBtn = document.getElementById('btn-menu-close');
    if (!btn || !menu) return;

    btn.addEventListener('click', () => {
      menu.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    });

    function closeMenu() {
      menu.classList.add('hidden');
      document.body.style.overflow = '';
    }

    closeBtn?.addEventListener('click', closeMenu);

    // Close menu when a link is clicked
    menu.querySelectorAll('.mobile-menu-link').forEach((link) => {
      link.addEventListener('click', closeMenu);
    });
  }

  function setupListeners() {
    const current = getSlideNumber();

    document.addEventListener('keydown', (e) => {
      // Don't navigate if mobile menu is open
      const menu = document.getElementById('mobile-menu');
      if (menu && !menu.classList.contains('hidden')) return;

      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
        e.preventDefault();
        goToSlide(getSlideNumber() + 1);
      } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
        e.preventDefault();
        goToSlide(getSlideNumber() - 1);
      } else if (e.key === 'f' || e.key === 'F') {
        toggleFullscreen();
      }
    });

    document.getElementById('btn-fullscreen')?.addEventListener('click', toggleFullscreen);

    document.getElementById('btn-pdf')?.addEventListener('click', () => {
      const btn = document.getElementById('btn-pdf');
      if (btn) btn.textContent = '📄 생성 중...';

      const printWin = window.open('', '_blank');
      if (!printWin) { if (btn) btn.textContent = '📄 PDF'; return; }

      printWin.document.write(`<!DOCTYPE html><html><head>
        <meta charset="UTF-8"><title>Onmeet Presentation PDF</title>
        <style>
          @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;700;800&family=Inter:wght@400;500;600&display=swap');
          *{margin:0;padding:0;box-sizing:border-box}
          body{background:#170230;color:#f0dfff;font-family:Inter,sans-serif}
          .page{width:100vw;height:100vh;page-break-after:always;overflow:hidden}
          .page:last-child{page-break-after:avoid}
          iframe{width:100%;height:100%;border:none}
          @media print{nav,footer{display:none!important}}
        </style></head><body>`);

      for (let i = 1; i <= TOTAL; i++) {
        printWin.document.write(`<div class="page"><iframe src="/slide/${i}"></iframe></div>`);
      }
      printWin.document.write('</body></html>');
      printWin.document.close();

      setTimeout(() => {
        printWin.print();
        if (btn) btn.textContent = '📄 PDF';
      }, 3000);
    });

    // Touch swipe support for mobile
    let touchStartX = 0;
    let touchStartY = 0;
    let swipeBlocked = false;

    document.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
      touchStartY = e.changedTouches[0].screenY;
      // Block swipe if touch started inside a .no-swipe element or mobile menu is open
      const target = e.target as HTMLElement;
      const menu = document.getElementById('mobile-menu');
      swipeBlocked = !!target.closest('.no-swipe') || !!target.closest('.code-scroll') || !!target.closest('.code-block') || (!!menu && !menu.classList.contains('hidden'));
    }, { passive: true });

    document.addEventListener('touchend', (e) => {
      if (swipeBlocked) return;
      const touchEndX = e.changedTouches[0].screenX;
      const touchEndY = e.changedTouches[0].screenY;
      const diffX = touchStartX - touchEndX;
      const diffY = touchStartY - touchEndY;

      // Only trigger if horizontal swipe is dominant and minimum 60px
      if (Math.abs(diffX) > Math.abs(diffY) && Math.abs(diffX) > 60) {
        if (diffX > 0) {
          // Swipe left → next slide
          goToSlide(getSlideNumber() + 1);
        } else {
          // Swipe right → prev slide
          goToSlide(getSlideNumber() - 1);
        }
      }
    }, { passive: true });

    setupMobileMenu();
  }

  // Run on initial load
  setupListeners();

  // Re-run after Astro client-side navigation
  document.addEventListener('astro:after-swap', setupListeners);
</script>

<style is:global>
  @import '../styles/global.css';
</style>
