---
import SlideLayout from '../../layouts/SlideLayout.astro';
import { Code } from 'astro:components';

const sseCode = `// NotificationService.java — Multi-tab SSE
Map<Long, Map<String, SseEmitter>> emitters =
    new ConcurrentHashMap<>();

public SseEmitter subscribe(Long userId) {
    SseEmitter emitter = new SseEmitter(DEFAULT_TIMEOUT);
    String emitterId = userId + "_" + UUID.randomUUID();
    emitters
        .computeIfAbsent(userId, k -> new ConcurrentHashMap<>())
        .put(emitterId, emitter);
    emitter.onCompletion(() -> removeEmitter(userId, emitterId));
    emitter.onTimeout(() -> removeEmitter(userId, emitterId));
    emitter.send(
        SseEmitter.event().name("connect").data("Connected!")
    );
    return emitter;
}`;

const fcmCode = `// FCM 알림 발송 (모바일 지원)
public void sendFcmNotification(
    Long userId, NotificationMessage msg
) {
    List<String> tokens = fcmTokenRepo.findByUserId(userId);
    if (tokens.isEmpty()) return;
    MulticastMessage message = MulticastMessage.builder()
        .addAllTokens(tokens)
        .setNotification(Notification.builder()
            .setTitle(msg.title())
            .setBody(msg.body())
            .build())
        .putAllData(msg.data())
        .build();
    FirebaseMessaging.getInstance()
        .sendEachForMulticast(message);
}`;

const toggleCode = `// 알림 설정 토글 — 발송 전 체크
public void sendNotification(
    Long userId, NotificationType type,
    NotificationMessage msg
) {
    NotificationSetting setting =
        settingRepo.findByUserId(userId);

    // 해당 카테고리 토글이 OFF면 발송 차단
    if (!setting.isEnabled(type)) return;

    // SSE 발송
    sendSseNotification(userId, msg);
    // FCM 발송
    sendFcmNotification(userId, msg);
}

// 유저별 알림 카테고리
enum NotificationType {
    MEETING,      // 회의 알림
    TEAM,         // 팀 알림
    MEETING_NOTE  // 회의록 알림
}`;
---

<SlideLayout title="notification-service Code" slideNumber={14}>
  <div class="w-full max-w-6xl mx-auto px-4 flex flex-col gap-3">

    <!-- Title -->
    <div class="text-center opacity-init anim-fade-up">
      <h1 class="font-['Manrope',sans-serif] font-bold text-3xl text-glow-sm" style="color:#cc97ff;">
        웹 + 모바일 실시간 알림 이중 채널
      </h1>
      <h2 class="text-sm mt-0.5 font-medium text-[#f0dfff]/60">notification-service · Java · Spring Boot · SSE · Firebase FCM · Kafka</h2>
    </div>

    <div class="grid grid-cols-3 gap-3 opacity-init anim-scale d-200">

      <!-- 1. Multi-tab SSE -->
      <div class="flex flex-col gap-2">
        <div class="flex items-center gap-2">
          <span class="text-xs font-mono font-bold" style="color:#cc97ff;">SSE Subscribe</span>
          <span class="badge badge-purple">Multi-tab</span>
        </div>
        <div class="code-block code-scroll" style="max-height:220px;">
          <Code code={sseCode} lang="java" theme="one-dark-pro" />
        </div>
        <div class="glass-card p-2">
          <div class="text-sm font-semibold text-[#cc97ff]">멀티탭 SSE 실시간 알림</div>
          <div class="text-xs text-[#f0dfff]/55 mt-0.5">
            userId → Map&lt;emitterId, SseEmitter&gt; 이중 Map 구조.
            여러 탭/디바이스 동시 연결 처리.
            30초 heartbeat로 dead emitter 자동 정리.
          </div>
        </div>
      </div>

      <!-- 2. FCM (가운데) -->
      <div class="flex flex-col gap-2">
        <div class="flex items-center gap-2">
          <span class="text-xs font-mono font-bold" style="color:#cc97ff;">FCM Dispatch</span>
          <span class="badge badge-orange">Firebase</span>
        </div>
        <div class="code-block code-scroll" style="max-height:220px;">
          <Code code={fcmCode} lang="java" theme="one-dark-pro" />
        </div>
        <div class="glass-card p-2">
          <div class="text-sm font-semibold text-[#ffb964]">FCM 모바일 푸시</div>
          <div class="text-xs text-[#f0dfff]/55 mt-0.5">
            Auth 서비스 최신 토큰 + 로컬 DB 토큰을 Set으로 합쳐 중복 없이 발송.
            실패 시 최대 3회 재시도, 무효 토큰 자동 삭제.
          </div>
        </div>
      </div>

      <!-- 3. 알림 설정 토글 -->
      <div class="flex flex-col gap-2">
        <div class="flex items-center gap-2">
          <span class="text-xs font-mono font-bold" style="color:#cc97ff;">Notification Toggle</span>
          <span class="badge badge-green">Settings</span>
        </div>
        <div class="code-block code-scroll" style="max-height:220px;">
          <Code code={toggleCode} lang="java" theme="one-dark-pro" />
        </div>
        <div class="glass-card p-2">
          <div class="text-sm font-semibold text-[#61ff96]">유저별 알림 설정 토글</div>
          <div class="text-xs text-[#f0dfff]/55 mt-0.5">
            회의 / 팀 / 회의록 3가지 카테고리 개별 ON/OFF.
            토글 OFF 시 발송 자체를 차단하는 구조.
          </div>
        </div>
      </div>

    </div>

    <!-- Kafka consumer + notification types -->
    <div class="glass-card p-2.5 opacity-init anim-fade-up d-400">
      <div class="flex items-center gap-4 flex-wrap">
        <div class="text-sm font-semibold" style="color:#cc97ff;">📨 Kafka Consumer Topics</div>
        {['meeting-start', 'meeting-end', 'ai-summary-ready', 'invitation', 'temporary-password'].map((t) => (
          <span class="badge badge-orange">{t}</span>
        ))}
      </div>
    </div>

  </div>
</SlideLayout>
