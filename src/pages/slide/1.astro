---
import SlideLayout from '../../layouts/SlideLayout.astro';

const participants = [
  { name: '대표', img: '/images/meeting/ceo.jpeg', color: '#cc97ff' },
  { name: '기획', img: '/images/meeting/planner.jpeg', color: '#e197fc' },
  { name: '개발자', img: '/images/meeting/developer.jpeg', color: '#9333EA' },
  { name: '디자이너', img: '/images/meeting/designer.jpeg', color: '#61aaff' },
];
---

<SlideLayout title="Hero" slideNumber={1}>
  <div class="w-full max-w-6xl mx-auto px-6 flex flex-col items-center justify-center gap-5">

    <!-- Title -->
    <div class="text-center opacity-init anim-fade-up">
      <h1
        class="font-['Manrope',sans-serif] font-extrabold text-[4.5rem] leading-none tracking-tight text-glow"
        style="color:#cc97ff;"
      >
        Onmeet
      </h1>
      <p class="text-2xl font-semibold mt-2" style="color:#e197fc;">
        AI가 회의를 기록하고, 요약하는 화상회의 플랫폼
      </p>
      <p class="text-base mt-1" style="color:#f0dfff;opacity:0.7;">
        B2B 기업용 MSA 기반 실시간 화상회의 &middot; AI 회의록 자동 생성 &middot; 실시간 알림
      </p>
      <button
        id="btn-play-demo"
        class="mt-4 inline-flex items-center gap-2 px-5 py-2.5 rounded-full font-semibold text-sm transition-all hover:scale-105 cursor-pointer border-none"
        style="background:linear-gradient(135deg,#9333EA,#cc97ff);color:#170230;box-shadow:0 0 24px #9333EA60;"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
        프로젝트 소개 영상
      </button>
    </div>

    <!-- Video modal -->
    <div id="video-modal" class="fixed inset-0 z-[100] hidden items-center justify-center" style="background:rgba(0,0,0,0.85);backdrop-filter:blur(12px);">
      <div class="relative w-full max-w-4xl mx-4">
        <button id="btn-close-video" class="absolute -top-10 right-0 text-xl text-[#cc97ff] bg-transparent border-none cursor-pointer hover:text-white transition-colors">✕ 닫기</button>
        <div class="rounded-xl overflow-hidden" style="aspect-ratio:16/9;background:#000;">
          <video id="demo-video" class="w-full h-full" controls preload="metadata">
            <source src="/videos/demo.mp4" type="video/mp4" />
          </video>
        </div>
      </div>
    </div>

    <!-- Main content: meeting photos + feature highlights -->
    <div class="w-full flex flex-col lg:flex-row items-center gap-6">

      <!-- Video conference card with real photos -->
      <div class="glass-card p-4 flex-1 opacity-init anim-fade-left d-200" style="max-width:480px;">
        <div class="flex items-center justify-between mb-3">
          <span class="text-xs font-semibold" style="color:#cc97ff;">● LIVE</span>
          <span class="text-xs" style="color:#f0dfff;opacity:0.5;">Q1 전략 회의 · 00:42:17</span>
          <span class="badge badge-purple">4명 참여 중</span>
        </div>
        <div class="grid grid-cols-2 gap-2" id="meeting-grid">
          {participants.map((p, i) => (
            <div
              class="meeting-participant relative rounded-lg overflow-hidden transition-all duration-300"
              data-index={i}
              style={`aspect-ratio:16/10;filter:brightness(0.6);transform:scale(1);`}
            >
              <img
                src={p.img}
                alt={p.name}
                class="w-full h-full object-cover"
              />
              <!-- Speaking highlight overlay -->
              <div
                class="speaking-glow absolute inset-0 rounded-lg pointer-events-none opacity-0 transition-opacity duration-300"
                style={`box-shadow:inset 0 0 0 3px ${p.color}, 0 0 20px ${p.color}60, 0 0 40px ${p.color}30;`}
              ></div>
              <!-- Dim overlay for non-speakers -->
              <div
                class="dim-overlay absolute inset-0 rounded-lg pointer-events-none transition-opacity duration-300"
                style="background:rgba(0,0,0,0.35);"
              ></div>
              <!-- Name tag -->
              <div class="absolute bottom-1.5 left-1.5 z-10 flex items-center gap-1">
                <div class="speaking-dot w-1.5 h-1.5 rounded-full bg-gray-500"></div>
                <span class="text-xs font-medium text-white/90 drop-shadow-lg">{p.name}</span>
              </div>
              <!-- Speaking badge -->
              <div class="speaking-badge absolute top-1.5 right-1.5 opacity-0 transition-opacity duration-300">
                <span class="badge badge-green text-xs" style="background:rgba(16,185,129,0.7);backdrop-filter:blur(4px);">발언 중</span>
              </div>
            </div>
          ))}
        </div>
        <div class="mt-3 flex items-center gap-2">
          <div class="flex-1 h-1.5 rounded-full bg-[#331557] overflow-hidden">
            <div class="ai-progress-bar h-full rounded-full" style="background:linear-gradient(90deg,#9333EA,#cc97ff);"></div>
          </div>
          <span class="text-xs ai-pulse-text" style="color:#cc97ff;">AI 요약 중...</span>
        </div>
      </div>

      <!-- Right: feature highlights -->
      <div class="flex-1 flex flex-col gap-3 opacity-init anim-fade-right d-300">
        {[
          { icon: '🎥', label: 'WebRTC 실시간 화상회의', sub: 'LiveKit 기반 갤러리/스피커 뷰, 대기실' },
          { icon: '🤖', label: 'AI 회의록 자동 생성', sub: 'OpenAI STT + Claude 요약, 리치 텍스트 에디터' },
          { icon: '🔔', label: '실시간 알림', sub: 'SSE + FCM, Kafka 이벤트 기반' },
          { icon: '🔐', label: 'B2B 기업급 보안', sub: 'RSA JWT/JWKS, AES-256-GCM 암호화' },
        ].map((f, i) => (
          <div class={`glass-card px-4 py-2.5 flex items-center gap-3 opacity-init anim-fade-right d-${300 + i * 100}`}>
            <span class="text-2xl">{f.icon}</span>
            <div>
              <div class="text-base font-semibold" style="color:#f0dfff;">{f.label}</div>
              <div class="text-sm" style="color:#f0dfff;opacity:0.55;">{f.sub}</div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Stats row -->
    <div class="w-full grid grid-cols-4 gap-3 opacity-init anim-fade-up d-600">
      {[
        { value: '7', label: 'Microservices' },
        { value: '5', label: 'Languages' },
        { value: 'Real-time', label: 'AI Pipeline' },
        { value: 'WebRTC', label: '+ LiveKit' },
      ].map((s) => (
        <div class="glass-card-bright text-center py-3 px-2 anim-pulse-glow">
          <div class="font-['Manrope',sans-serif] font-bold text-xl gradient-text">{s.value}</div>
          <div class="text-sm mt-0.5" style="color:#f0dfff;opacity:0.6;">{s.label}</div>
        </div>
      ))}
    </div>

  </div>
</SlideLayout>

<style>
  @keyframes ai-fill {
    0% { width: 0%; }
    80% { width: 100%; }
    100% { width: 100%; }
  }
  .ai-progress-bar {
    animation: ai-fill 3s ease-in-out infinite;
  }
  @keyframes ai-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }
  .ai-pulse-text {
    animation: ai-pulse 2s ease-in-out infinite;
  }
</style>

<script>
  function initSpeakingEffect() {
    const participants = document.querySelectorAll('.meeting-participant');
    if (participants.length === 0) return;

    let currentSpeaker = -1;
    let timeoutId: ReturnType<typeof setTimeout>;

    function clearSpeaker() {
      participants.forEach((p) => {
        const el = p as HTMLElement;
        const glow = p.querySelector('.speaking-glow') as HTMLElement;
        const dim = p.querySelector('.dim-overlay') as HTMLElement;
        const dot = p.querySelector('.speaking-dot') as HTMLElement;
        const badge = p.querySelector('.speaking-badge') as HTMLElement;
        if (glow) glow.style.opacity = '0';
        if (dim) dim.style.opacity = '1';
        if (dot) { dot.classList.remove('bg-green-400'); dot.classList.add('bg-gray-500'); }
        if (badge) badge.style.opacity = '0';
        el.style.filter = 'brightness(0.6)';
        el.style.transform = 'scale(1)';
        el.style.zIndex = '0';
      });
    }

    function activateSpeaker(index: number) {
      clearSpeaker();
      const p = participants[index] as HTMLElement;
      const glow = p.querySelector('.speaking-glow') as HTMLElement;
      const dim = p.querySelector('.dim-overlay') as HTMLElement;
      const dot = p.querySelector('.speaking-dot') as HTMLElement;
      const badge = p.querySelector('.speaking-badge') as HTMLElement;
      if (glow) glow.style.opacity = '1';
      if (dim) dim.style.opacity = '0';
      if (dot) { dot.classList.remove('bg-gray-500'); dot.classList.add('bg-green-400'); }
      if (badge) badge.style.opacity = '1';
      p.style.filter = 'brightness(1)';
      p.style.transform = 'scale(1.05)';
      p.style.zIndex = '10';
      currentSpeaker = index;
    }

    function nextSpeaker() {
      // Pick a random speaker different from current
      let next: number;
      do {
        next = Math.floor(Math.random() * participants.length);
      } while (next === currentSpeaker && participants.length > 1);

      activateSpeaker(next);

      // Random duration: 1~3 seconds
      const duration = 1000 + Math.random() * 2000;
      timeoutId = setTimeout(nextSpeaker, duration);
    }

    // Start after a short delay
    setTimeout(nextSpeaker, 500);

    // Cleanup on navigation
    document.addEventListener('astro:before-swap', () => {
      clearTimeout(timeoutId);
    }, { once: true });
  }

  function initVideoModal() {
    const btnPlay = document.getElementById('btn-play-demo');
    const modal = document.getElementById('video-modal');
    const btnClose = document.getElementById('btn-close-video');
    const video = document.getElementById('demo-video') as HTMLVideoElement;
    if (!btnPlay || !modal || !video) return;

    btnPlay.addEventListener('click', () => {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      video.play();
    });

    function closeModal() {
      video.pause();
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    btnClose?.addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) closeModal();
    });
  }

  // Run on initial load
  initVideoModal();
  initSpeakingEffect();

  // Re-run after Astro client-side navigation
  document.addEventListener('astro:after-swap', () => {
    initVideoModal();
    initSpeakingEffect();
  });
</script>
