---
import SlideLayout from '../../layouts/SlideLayout.astro';

// Simple Icons CDN: https://cdn.simpleicons.org/{slug}/{color}
const si = (slug: string, color = 'white') => `https://cdn.simpleicons.org/${slug}/${color}`;
const ji = (slug: string) => `https://cdn.jsdelivr.net/gh/simple-icons/simple-icons/icons/${slug}.svg`;

const columns = [
  {
    title: 'Backend',
    icon: si('spring', '6DB33F'),
    color: '#9333EA',
    badgeClass: 'badge-purple',
    techs: [
      { logo: si('springboot', '6DB33F'), name: 'Spring Boot 3.3.5' },
      { logo: si('kotlin', '7F52FF'), name: 'Kotlin (auth/gateway)' },
      { logo: si('openjdk', 'FFFFFF'), name: 'Java (ai/video/noti)' },
      { logo: si('go', '00ADD8'), name: 'Go (file-service)' },
      { logo: si('springsecurity', '6DB33F'), name: 'Spring Security' },
      { logo: si('spring', '6DB33F'), name: 'Spring WebFlux' },
      { logo: si('hibernate', '59666C'), name: 'JPA + Flyway' },
    ],
  },
  {
    title: 'Frontend',
    icon: si('react', '61DAFB'),
    color: '#61aaff',
    badgeClass: 'badge-blue',
    techs: [
      { logo: si('react', '61DAFB'), name: 'React 18' },
      { logo: si('typescript', '3178C6'), name: 'TypeScript' },
      { logo: si('vite', '646CFF'), name: 'Vite 7' },
      { logo: '', name: 'Zustand v5', emoji: '🐻' },
      { logo: si('reactquery', 'FF4154'), name: 'TanStack Query v5' },
      { logo: si('reactrouter', 'CA4245'), name: 'React Router v6' },
      { logo: si('tailwindcss', '06B6D4'), name: 'Tailwind CSS' },
      { logo: si('cloudflare', 'F38020'), name: 'Cloudflare Pages' },
    ],
  },
  {
    title: 'AI & Media',
    icon: ji('openai'),
    color: '#e197fc',
    badgeClass: 'badge-purple',
    techs: [
      { logo: ji('openai'), name: 'OpenAI STT' },
      { logo: si('anthropic', 'D4A27F'), name: 'Claude API' },
      { logo: si('onnx', '005CED'), name: 'Silero VAD ONNX' },
      { logo: si('livekit', '000000'), name: 'LiveKit SFU' },
      { logo: si('webrtc', '333333'), name: 'WebRTC' },
      { logo: si('gmail', 'EA4335'), name: 'Gmail OAuth2' },
      { logo: si('thymeleaf', '005F0F'), name: 'Thymeleaf' },
    ],
  },
  {
    title: 'Infrastructure',
    icon: si('docker', '2496ED'),
    color: '#61ffe6',
    badgeClass: 'badge-cyan',
    techs: [
      { logo: si('googlecloud', '4285F4'), name: 'GCP e2-standard-4' },
      { logo: si('docker', '2496ED'), name: 'Docker + Compose' },
      { logo: si('githubactions', '2088FF'), name: 'GitHub Actions' },
      { logo: si('apachekafka', '231F20'), name: 'Kafka 7.5.0' },
      { logo: si('redis', 'FF4438'), name: 'Redis 7' },
      { logo: si('mysql', '4479A1'), name: 'MySQL 9.0' },
      { logo: si('postgresql', '4169E1'), name: 'PostgreSQL 16' },
      { logo: si('minio', 'C72E49'), name: 'MinIO (S3)' },
      { logo: si('nginx', '009639'), name: 'Nginx' },
      { logo: si('cloudflare', 'F38020'), name: 'Cloudflare DNS' },
    ],
  },
];
---

<SlideLayout title="Tech Stack" slideNumber={5}>
  <div class="w-full max-w-6xl mx-auto px-6 flex flex-col gap-4">

    <!-- Title -->
    <div class="text-center opacity-init anim-fade-up">
      <h1 class="font-['Manrope',sans-serif] font-bold text-4xl text-glow-sm" style="color:#cc97ff;">Tech Stack</h1>
      <h2 class="text-sm mt-0.5 font-medium" style="color:#f0dfff;opacity:0.6;">사용 기술 전체 목록</h2>
    </div>

    <!-- 4 columns -->
    <div class="grid grid-cols-4 gap-4">
      {columns.map((col, i) => (
        <div
          class={`glass-card p-4 flex flex-col gap-3 opacity-init anim-fade-up d-${200 + i * 100}`}
          style={`border-color:${col.color}30;`}
        >
          <div class="flex items-center gap-2">
            <img src={col.icon} alt="" class="w-5 h-5 tech-icon" />
            <span class="font-['Manrope',sans-serif] font-bold text-base" style={`color:${col.color};`}>{col.title}</span>
          </div>
          <div class="h-px" style={`background:linear-gradient(90deg,${col.color}50,transparent);`}></div>
          <div class="flex flex-wrap gap-1.5">
            {col.techs.map((t) => (
              <span class={`badge ${col.badgeClass} flex items-center gap-1.5`}>
                {t.logo ? (
                  <img src={t.logo} alt="" class="w-3.5 h-3.5 tech-icon" />
                ) : (
                  <span class="text-xs">{t.emoji}</span>
                )}
                {t.name}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Language summary -->
    <div class="flex flex-wrap items-center justify-center gap-3 opacity-init anim-fade-up d-600">
      <div class="flex flex-wrap items-center justify-center gap-3">
        {[
          { lang: 'Kotlin', pct: 30, color: '#9333EA', logo: si('kotlin', '7F52FF') },
          { lang: 'Java', pct: 40, color: '#61aaff', logo: si('openjdk', 'FFFFFF') },
          { lang: 'Go', pct: 15, color: '#61ffe6', logo: si('go', '00ADD8') },
          { lang: 'TypeScript', pct: 15, color: '#ffb964', logo: si('typescript', '3178C6') },
        ].map((l) => (
          <div class="flex items-center gap-1.5">
            <img src={l.logo} alt="" class="w-3.5 h-3.5 tech-icon" />
            <span class="text-sm font-medium text-[#f0dfff]/80">{l.lang}</span>
            <span class="text-sm" style={`color:${l.color};`}>{l.pct}%</span>
          </div>
        ))}
      </div>
      <div class="h-3 flex rounded-full overflow-hidden w-48">
        <div style="width:30%;background:#9333EA;"></div>
        <div style="width:40%;background:#61aaff;"></div>
        <div style="width:15%;background:#61ffe6;"></div>
        <div style="width:15%;background:#ffb964;"></div>
      </div>
    </div>

  </div>
</SlideLayout>
