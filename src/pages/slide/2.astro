---
import SlideLayout from '../../layouts/SlideLayout.astro';

const members = [
  {
    name: '최승은',
    role: '팀장 / Full-Stack',
    github: '@xeunnie',
    color: '#9370DB',
    photo: '/images/developer/choi.jpeg',
    tasks: [
      '프로젝트 총괄',
      'Video Service 개발',
      '화상회의/채팅/대기실',
      'FE 전반 개발',
    ],
  },
  {
    name: '박영진',
    role: 'Backend Lead',
    github: '@sprtms16',
    color: '#61aaff',
    photo: '/images/developer/park.jpeg',
    tasks: [
      'MSA 전체 설계',
      'Auth/Gateway Service',
      'CI/CD 파이프라인',
      'Go 전환 최적화',
    ],
  },
  {
    name: '조예성',
    role: 'Backend',
    github: '@yesung1215',
    color: '#61ffe6',
    photo: '/images/developer/jo.jpeg',
    tasks: [
      'Notification Service',
      'Flyway 마이그레이션',
      '인프라 안정화',
      '모니터링 설정',
    ],
  },
  {
    name: '양진영',
    role: 'AI Backend',
    github: '@rkddl94',
    color: '#ffb964',
    photo: '/images/developer/yang.jpeg',
    tasks: [
      'AI Service 개발',
      'STT 음성 인식',
      'LLM 회의록 생성',
      'AI 파이프라인 구축',
    ],
  },
];
---

<SlideLayout title="Developers" slideNumber={2}>
  <div class="w-full max-w-5xl mx-auto px-6 flex flex-col items-center gap-8">

    <!-- Title -->
    <div class="text-center opacity-init anim-fade-up">
      <h1 class="font-['Manrope',sans-serif] font-extrabold text-4xl text-glow" style="color:#cc97ff;">
        팀 구성 및 역할
      </h1>
      <h2 class="text-base mt-2 font-medium text-[#f0dfff]/60">
        Onmeet을 만든 사람들
      </h2>
    </div>

    <!-- Team grid -->
    <div class="grid grid-cols-4 gap-5 w-full opacity-init anim-fade-up d-200">
      {members.map((m, i) => (
        <div
          class={`glass-card-bright p-6 flex flex-col items-center gap-4 text-center opacity-init anim-fade-up d-${200 + i * 100} hover:scale-105 transition-transform`}
          style={`border-top:3px solid ${m.color};`}
        >
          <!-- Photo -->
          <div
            class="w-20 h-20 rounded-full overflow-hidden"
            style={`border:3px solid ${m.color};`}
          >
            <img src={m.photo} alt={m.name} class="w-full h-full object-cover" />
          </div>

          <!-- Name & role -->
          <div>
            <div class="font-['Manrope',sans-serif] font-bold text-xl text-[#f0dfff]">
              {m.name}
            </div>
            <div class="text-sm font-semibold mt-1" style={`color:${m.color};`}>{m.role}</div>
            <div class="text-xs text-[#f0dfff]/40 mt-0.5">{m.github}</div>
          </div>

          <!-- Divider -->
          <div class="w-full h-px" style={`background:${m.color}30;`}></div>

          <!-- Tasks -->
          <div class="text-left w-full flex flex-col gap-1.5">
            {m.tasks.map((task) => (
              <div class="text-sm text-[#f0dfff]/70">{task}</div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Team note -->
    <div class="glass-card px-6 py-3 text-center opacity-init anim-fade-up d-700">
      <p class="text-sm text-[#f0dfff]/60">
        <span style="color:#cc97ff;" class="font-semibold">4</span> developers ·
        <span style="color:#e197fc;" class="font-semibold">7</span> microservices ·
        <span style="color:#61aaff;" class="font-semibold">5</span> languages ·
        Built with passion
      </p>
    </div>

  </div>
</SlideLayout>
