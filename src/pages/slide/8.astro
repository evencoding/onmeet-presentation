---
import SlideLayout from '../../layouts/SlideLayout.astro';
---

<SlideLayout title="Frontend Architecture" slideNumber={8}>
  <div class="w-full max-w-6xl mx-auto px-4 flex flex-col gap-3">

    <!-- Title -->
    <div class="text-center opacity-init anim-fade-up">
      <h1 class="font-['Manrope',sans-serif] font-bold text-4xl text-glow-sm" style="color:#cc97ff;">Frontend Architecture</h1>
      <h2 class="text-sm mt-0.5 font-medium" style="color:#f0dfff;opacity:0.6;">React 18 · TypeScript (strict) · Vite 7 · Tailwind CSS</h2>
    </div>

    <div class="grid grid-cols-3 gap-3">

      <!-- Col 1: Core Architecture -->
      <div class="flex flex-col gap-2 opacity-init anim-fade-left d-200">
        <div class="glass-card p-3">
          <div class="text-sm font-semibold mb-2" style="color:#cc97ff;">📐 Feature-Sliced Design</div>
          {[
            { label: 'app/', desc: '라우팅, ErrorBoundary, 글로벌 설정', color: '#cc97ff' },
            { label: 'features/', desc: 'auth · meeting · ai · notification · schedule · team', color: '#9333EA' },
            { label: 'shared/', desc: 'utils · hooks · components · ui (shadcn)', color: '#61aaff' },
            { label: 'pages/', desc: 'NotFound, 라우트별 페이지', color: '#61ffe6' },
          ].map((l) => (
            <div class="flex items-center gap-2 mb-1.5">
              <div class="w-1 h-6 rounded-full shrink-0" style={`background:${l.color};`}></div>
              <div>
                <span class="text-xs font-bold font-mono" style={`color:${l.color};`}>{l.label}</span>
                <span class="text-xs text-[#f0dfff]/50 ml-1">{l.desc}</span>
              </div>
            </div>
          ))}
        </div>

        <div class="glass-card p-3">
          <div class="text-sm font-semibold mb-1.5" style="color:#e197fc;">🏗️ 디자인 패턴</div>
          {[
            { label: 'VAC 패턴', desc: '로직 컨테이너 + 순수 UI 분리 (597→225L)', color: '#e197fc' },
            { label: 'Custom Hooks', desc: 'useMeetingDevices · useMicTest · useWaitingRoomSSE', color: '#cc97ff' },
            { label: 'Compound Components', desc: 'Radix UI 기반 합성 컴포넌트', color: '#9333EA' },
          ].map((p) => (
            <div class="mb-1.5">
              <div class="text-xs font-semibold" style={`color:${p.color};`}>{p.label}</div>
              <div class="text-xs text-[#f0dfff]/50">{p.desc}</div>
            </div>
          ))}
        </div>
      </div>

      <!-- Col 2: Core Tech -->
      <div class="flex flex-col gap-2 opacity-init anim-scale d-300">
        <div class="glass-card p-3">
          <div class="text-sm font-semibold mb-1.5" style="color:#61aaff;">🔌 Service Fetch Factory</div>
          <div class="text-xs text-[#f0dfff]/55 mb-1">4개 MSA의 중복 fetch를 팩토리 패턴으로 통합</div>
          <div class="code-block code-scroll p-2" style="max-height:70px;font-size:0.7rem;line-height:1.4;">
            <code style="color:#61aaff;">const roomFetch = createServiceFetch("/video/v1");</code><br/>
            <code style="color:#e197fc;">const aiFetch   = createServiceFetch("/ai");</code><br/>
            <code style="color:#61ffe6;">const notiFetch = createServiceFetch("/notification");</code>
          </div>
          <div class="text-xs text-[#f0dfff]/45 mt-1">Content-Type 자동 설정 · X-User-Id 주입 · 401 자동 갱신</div>
        </div>

        <div class="glass-card p-3">
          <div class="text-sm font-semibold mb-1.5" style="color:#cc97ff;">📡 커스텀 SSE 파서</div>
          <div class="text-xs text-[#f0dfff]/55 mb-1.5">EventSource 대신 fetch + ReadableStream 직접 구현</div>
          {[
            '실시간 알림 → React Query 캐시 무효화',
            '대기실 승인/거절 → Phase 상태 전이',
            '실시간 STT → useRef 버퍼 + flush 최적화',
            '연결 끊김 시 5초 자동 재연결',
          ].map((item) => (
            <div class="text-xs text-[#f0dfff]/50 mb-0.5">· {item}</div>
          ))}
        </div>

        <div class="glass-card p-3">
          <div class="text-sm font-semibold mb-1.5" style="color:#9333EA;">🎬 Phase 상태 머신</div>
          <div class="flex items-center gap-1 flex-wrap text-xs">
            {['Preparing', '→', 'Joining', '→', 'Waiting', '→', 'Connected', '→', 'Disconnected'].map((s, i) => (
              <span class={i % 2 === 0 ? 'text-[#cc97ff] font-medium' : 'text-[#533e6d]'}>{s}</span>
            ))}
          </div>
          <div class="text-xs text-[#f0dfff]/45 mt-1">카메라/마이크 열거 · 실시간 프리뷰 · 호스트 퇴장 감지</div>
        </div>
      </div>

      <!-- Col 3: Performance + Security -->
      <div class="flex flex-col gap-2 opacity-init anim-fade-right d-400">
        <div class="glass-card p-3">
          <div class="text-sm font-semibold mb-1.5" style="color:#61ff96;">⚡ 성능 최적화</div>
          {[
            { label: 'Route-level lazy loading', desc: '10+ 페이지 React.lazy 동적 로딩' },
            { label: 'Manual chunk splitting', desc: 'LiveKit · TipTap · Firebase · Recharts 독립 청크' },
            { label: 'Route prefetching', desc: '사이드바 hover 시 다음 페이지 미리 로드' },
            { label: 'React.memo / useShallow', desc: '회의 컴포넌트 리렌더 최소화' },
            { label: 'Production drop', desc: 'esbuild.drop으로 console/debugger 제거' },
          ].map((o) => (
            <div class="mb-1">
              <div class="text-xs font-semibold text-[#61ff96]">{o.label}</div>
              <div class="text-xs text-[#f0dfff]/45">{o.desc}</div>
            </div>
          ))}
        </div>

        <div class="glass-card p-3">
          <div class="text-sm font-semibold mb-1.5" style="color:#ff95a0;">🔐 보안</div>
          {[
            'CSP — default-src \'self\' 화이트리스트',
            'HttpOnly 쿠키 인증 (XSS 토큰 탈취 차단)',
            '401 → Promise 싱글턴 자동 갱신',
            'DOMPurify XSS 방지',
            'ProtectedRoute / GuestRoute / ManagerRoute',
          ].map((s) => (
            <div class="text-xs text-[#f0dfff]/50 mb-0.5">· {s}</div>
          ))}
        </div>

        <div class="glass-card p-3">
          <div class="text-sm font-semibold mb-1.5" style="color:#ffb964;">📱 PWA</div>
          <div class="text-xs text-[#f0dfff]/50">정적 에셋 Precaching · API NetworkFirst 캐싱 · 오프라인 폴백 · Service Worker 자동 갱신</div>
        </div>
      </div>

    </div>

    <!-- Tech badges bottom -->
    <div class="flex flex-wrap gap-1.5 justify-center opacity-init anim-fade-up d-500">
      {['React 18', 'TypeScript', 'Vite 7', 'Zustand v5', 'TanStack Query v5', 'LiveKit SDK',
        'Tailwind CSS', 'shadcn/ui', 'PWA', 'Sentry', 'FCM', 'Cloudflare Pages'].map((t) => (
        <span class="badge badge-blue">{t}</span>
      ))}
    </div>

  </div>
</SlideLayout>
